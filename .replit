modules = ["python-base-3.13", "web", "nodejs-22"]
run = "npm ci --include=dev && uv run --extra api --extra test node scripts/dev-local.mjs"

[env]
PORT = "5000"
VITE_LAGA_MODE = "api"
VITE_LAGA_API_BASE = "/api/v1"

[deployment]
build = ["sh", "-c", "npm ci --include=dev && python -m pip install --target .pythonlibs/lib/python3.11/site-packages --upgrade \".[api]\" && npm run build"]
run = ["node", "scripts/start-app.mjs"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm ci --include=dev && uv run --extra api --extra test node scripts/dev-local.mjs"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[packager.features]
enabledForHosting = false

[userenv]

[userenv.development]
LAGA_DATABASE = "data/demo-phase7f/backend.sqlite3"
LAGA_RAG_ENABLED = "false"
LAGA_RAG_EXPECTED_CORPUS_ID = "74176289f06d1ecbcb70b901b1fb4fb1f6194194623a06502151ce431f005fc0"
LAGA_RAG_SYNTHETIC_DEMO_ENABLED = "false"
PINECONE_CLOUD = "aws"
PINECONE_INDEX_NAME = "laga-rag"
PINECONE_NAMESPACE = "laga-hydrid"
PINECONE_REGION = "us-east-1"
PINECONE_SPARSE_INDEX_NAME = "laga-rag-sparse"

[userenv.shared]
