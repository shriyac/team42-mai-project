modules = ["nodejs-20", "python-3.11", "web"]
run = "npm run dev"

[env]
PORT = "5174"

[deployment]
build = ["sh", "-c", "npm ci --include=dev && npm run build"]
run = ["node", "scripts/serve.mjs"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 5174
externalPort = 80

[nix]
channel = "stable-25_05"
