modules = ["python-base-3.13", "web", "nodejs-22"]
run = "npm ci --include=dev && python -m pip install --target .pythonlibs/lib/python3.11/site-packages --upgrade \".[api]\" && npm run dev:local"

[env]
PORT = "5000"
VITE_LAGA_MODE = "api"
VITE_LAGA_API_BASE = "/api/v1"

[deployment]
build = ["sh", "-c", "npm ci --include=dev && python -m pip install --target .pythonlibs/lib/python3.11/site-packages --upgrade \".[api]\" && npm run build"]
run = ["node", "scripts/start-app.mjs"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm ci --include=dev && python -m pip install --target .pythonlibs/lib/python3.11/site-packages --upgrade \".[api]\" && npm run dev:local"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[packager.features]
enabledForHosting = false
