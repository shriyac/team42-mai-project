# Copy to .env beside ingest_leases.py and ask_lease.py.
# The local scripts read this file directly; never commit actual keys.
EMBEDDING_PROVIDER=nebius
NEBIUS_API_KEY=
FIREWORKS_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=rental-lease-qwen3-8b
# Separate sparse index for keyword retrieval; defaults to <dense index name>-sparse.
PINECONE_SPARSE_INDEX_NAME=rental-lease-qwen3-8b-sparse
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE_PREFIX=lease-demo
# Answer generation (Nebius OpenAI-compatible endpoint).
LLM_API_KEY_NAME=NEBIUS_API_KEY
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
