# Mock mode is the default. No secrets belong in VITE_* variables.
VITE_LAGA_MODE=mock
VITE_LAGA_API_BASE=/api/v1
# For local Python integration: set VITE_LAGA_MODE=api and LAGA_API_PROXY=http://127.0.0.1:8001

# A separately hosted API can also be used directly (requires credentialed CORS):
# VITE_LAGA_API_BASE=https://api.example.com/api/v1
# VITE_* settings are embedded at build time. Restart dev / rebuild production.
# Explorer: http://localhost:5174/api-docs/ (independent of application mock/api mode).

# State-law review UI and client verification for BOTH roles. Off by default.
VITE_LAGA_STATE_VERIFICATION=false
